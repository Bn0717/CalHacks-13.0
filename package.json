{
  "name": "calhack",
  "version": "0.1.0",
  "private": true,
  "description": "Press a hotkey on any how-to and it does the steps for you, after checking each one is safe.",
  "type": "module",
  "main": "dist/app/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "demo": "tsx src/cli/demo.ts",
    "demo:pages": "tsx src/cli/serve-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pdfjs-dist": "^6.4.299",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "electron": "^45.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
