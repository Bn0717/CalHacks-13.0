{
  "name": "calhack",
  "version": "0.1.0",
  "private": true,
  "description": "Press a hotkey on any how-to: Claude reads the steps, Droid runs the approved ones, and a separate Claude review proves it worked.",
  "type": "module",
  "main": "dist/app/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "demo": "tsx src/cli/demo.ts",
    "demo:pages": "tsx src/cli/serve-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "droid:check": "tsx src/cli/droid-check.ts",
    "eval": "tsx src/cli/eval.ts",
    "voice:setup": "node scripts/voice-setup.mjs",
    "voice:heart:setup": "python3 -m venv .kokoro && .kokoro/bin/pip install kokoro-onnx==0.6.1 soundfile && .kokoro/bin/python scripts/kokoro-setup.py",
    "agent:sim": "tsx src/cli/agent-sim.ts",
    "pointer:compare": "tsx src/cli/pointer-compare.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@factory/droid-sdk": "^0.10.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "electron": "^45.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
