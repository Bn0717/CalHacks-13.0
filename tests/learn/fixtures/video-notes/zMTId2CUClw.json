rt\": 234,\n      \"end\": 352,\n      \"chapter\": \"Adding HTML Elements\",\n      \"action\": \"Presenter types 'hello world!' into Notepad, saves the file, reloads the browser, and zooms in.\",\n      \"file\": \"index.html\",\n      \"code\": \"hello world!\"\n    },\n    {\n      \"start\": 352,\n      \"end\": 551,\n      \"chapter\": \"Adding HTML Elements\",\n      \"action\": \"Presenter explains HTML concept and wraps 'hello world!!!!!' in <strong> tags to bold the text.\",\n      \"file\": \"index.html\",\n      \"code\": \"<strong>hello world!!!!!</strong>\"\n    },\n    {\n      \"start\": 551,\n      \"end\": 720,\n      \"chapter\": \"Adding HTML Elements\",\n      \"action\": \"Presenter adds 'My name is <strong>Coder Coder.</strong>' and '<em>I really like coding!</em>' to demonstrate bold, italics, and whitespace collapsing in HTML.\",\n      \"file\": \"index.html\",\n      \"code\": \"<strong>hello world!!!!!</strong>\\n\\nMy name is <strong>Coder Coder.</strong>\\n\\n<em>I really like coding!</em>\"\n    },\n    {\n      \"start\": 720,\n      \"end\": 868,\n      \"chapter\": \"Adding HTML Elements\",\n      \"action\": \"Presenter introduces paragraph (<p>) tags and wraps the first line in <p> tags.\",\n      \"file\": \"index.html\",\n      \"code\": \"<p><strong>hello world!!!!!</strong>\\n</p>\\n\\nMy name is <strong>Coder Coder.</strong>\\n\\n<em>I really like coding!</em>\"\n    },\n    {\n      \"start\": 868,\n      \"end\": 973,\n      \"chapter\": \"Adding HTML Elements\",\n      \"action\": \"Presenter wraps all lines in <p> tags and changes the first paragraph tag to an <h1> header tag.\",\n      \"file\": \"index.html\",\n      \"code\": \"<h1>hello world!!!!!</h1>\\n\\n<p>My name is <strong>Coder\\nCoder.</strong></p>\\n\\n<p><em>I really like coding!</em></p>\"\n    },\n    {\n      \"start\": 973,\n      \"end\": 1091,\n      \"chapter\": \"Styling with CSS\",\n      \"action\": \"Presenter introduces CSS and adds opening and closing <style> tags above the HTML content.\",\n      \"file\": \"index.html\",\n      \"code\": \"<style>\\n\\n</style>\\n\\n<h1>hello world!!!!!</h1>\\n\\n<p>My name is <strong>Coder\\nCoder.</strong></p>\\n\\n<p><em>I really like coding!</em></p>\"\n    },\n    {\n      \"start\": 1091,\n      \"end\": 1252,\n      \"chapter\": \"Styling with CSS\",\n      \"action\": \"Presenter adds a CSS style rule targeting the 'body' tag to set 'background: lightblue;'.\",\n      \"file\": \"index.html\",\n      \"code\": \"<style>\\n  body {\\n    background: lightblue;\\n  }\\n</style>\\n\\n<h1>hello world!!!!!</h1>\\n\\n<p>My name is <strong>Coder\\nCoder.</strong></p>\\n\\n<p><em>I really like coding!</em></p>\"\n    },\n    {\n      \"start\": 1252,\n      \"end\": 1385,\n      \"chapter\": \"Styling with CSS\",\n      \"action\": \"Presenter adds a CSS style rule targeting 'h1' to set font-family to Arial and color to darkblue.\",\n      \"file\": \"index.html\",\n      \"code\": \"<style>\\n  body {\\n    background: lightblue;\\n  }\\n  \\n  h1 {\\n    font-family: Arial;\\n    color: darkblue;\\n  }\\n</style>\\n\\n<h1>hello world!!!!!</h1>\\n\\n<p>My name is <strong>Coder\\nCoder.</strong></p>\\n\\n<p><em>I really like coding!</em></p>\"\n    },\n    {\n      \"start\": 1385,\n      \"end\": 1421,\n      \"chapter\": \"Conclusion\",\n      \"action\": \"Presenter summarizes the lesson, encourages viewers to subscribe, and previews upcoming HTML and CSS tutorials.\",\n      \"file\": \"\",\n      \"code\": \"\"\n    }\n  ]\n}",
