# Copy this file to .env and paste your key from console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-opus-5-5).
# CALHACK_MODEL=claude-opus-5-5
# Optional: the shortcut (default Control+Alt+Command+D). Change it if another app already uses it.
# CALHACK_HOTKEY=Control+Alt+Command+D

# Droid (Factory) runs the approved steps. Get a key at app.factory.ai → Settings → API keys.
# Without it, CalHack runs the steps itself.
FACTORY_API_KEY=
# Optional: which model Droid uses (default claude-sonnet-5-5; run `npm run droid:check` to see yours).
# CALHACK_DROID_MODEL=
# Optional: where the droid program is, if it isn't on your PATH.
# CALHACK_DROID_PATH=

CALHACK_MODEL=
CALHACK_HOTKEY=
CALHACK_DROID_MODEL=

# Screenshot pointer positioning (the action planner and Accessibility routes stay separate).
# Official TypeSafe key: https://typesafe.ai — add it when ready; no key uses Haiku.
TYPESAFE_API_KEY=
# auto = Jev when keyed, otherwise Haiku. jev also falls back to Haiku. haiku bypasses Jev.
CALHACK_POINTER_PROVIDER=auto
CALHACK_JEV_MODEL=jev-1.14.0
CALHACK_HAIKU_POINTER_MODEL=claude-haiku-5-5
# Provisional Jev thresholds; tune against your own screenshots.
CALHACK_JEV_MIN_PRESENCE=0.90
CALHACK_JEV_MIN_CONFIDENCE=0.80

# Full UI decisions: next action, wait/finish, action safety, and visible verification.
# auto uses Jev when keyed, with Claude fallback; claude keeps the previous UI planner.
CALHACK_UI_DECISION_PROVIDER=auto

# Optional: a backup join link (https), used only when the "Join your visit" link can't be read from the email.
# CALHACK_JOIN_LINK=
